# LLM Provider Configuration
# Supported providers: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (set the one corresponding to your provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional Web Search Provider (leave empty for graceful no-external-search mode)
SEARCH_API_KEY=
SEARCH_PROVIDER=duckduckgo

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./startup_investigations.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DEBUG=true
